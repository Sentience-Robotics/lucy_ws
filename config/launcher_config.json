{
    "packages": [
        {
            "id": "core",
            "name": "Core (Lucy Bringup)",
            "description": "Base robot software stack",
            "type": "core",
            "dependencies": [],
            "conflicts": [],
            "command": "ros2 launch lucy_bringup lucy.launch.py",
            "readiness_check": "pgrep -f '[r]osbridge_websocket' >/dev/null 2>&1",
            "readiness_timeout": 60,
            "default_on": false
        },
        {
            "id": "gazebo",
            "name": "... with Simulator",
            "description": "(Gazebo)",
            "type": "modifier",
            "dependencies": ["core"],
            "conflicts": ["real"],
            "command": "gazebo:=true",
            "runs_on_vnc": true,
            "readiness_check": "pgrep -f '[g]azebo' >/dev/null 2>&1",
            "readiness_timeout": 120,
            "default_on": false
        },
        {
            "id": "rviz",
            "name": "... with Visualizer",
            "description": "(RViz)",
            "type": "modifier",
            "dependencies": ["core"],
            "conflicts": [],
            "command": "rviz:=true",
            "runs_on_vnc": true,
            "readiness_check": "pgrep -x rviz2 >/dev/null 2>&1",
            "readiness_timeout": 60,
            "default_on": false
        },
        {
            "id": "real",
            "name": "... with Real Hardware",
            "description": "(Connect to physical robot)",
            "type": "modifier",
            "dependencies": ["core"],
            "conflicts": ["gazebo"],
            "command": "real:=true",
            "default_on": false
        },
        {
            "id": "control_panel",
            "name": "Control Panel",
            "description": "Web-based UI (http://localhost:5000/)",
            "type": "interface",
            "dependencies": [],
            "conflicts": [],
            "command": {
                "start": "tmux new-window -d -n control_panel 'cd /workspace/src/lucy_control_panel && yarn dev'",
                "stop": "tmux kill-window -t lucy_ws:control_panel 2>/dev/null || true",
                "is_running": "tmux list-windows -F '#{window_name}' | grep -q '^control_panel$'"
            },
            "readiness_check": "pgrep -f '[v]ite' >/dev/null 2>&1",
            "readiness_timeout": 120,
            "default_on": false
        },
        {
            "id": "novnc",
            "name": "noVNC (Web Viewer)",
            "description": "View the desktop in a browser (http://localhost:6080/vnc.html)",
            "type": "tool",
            "requires_env": "LUCY_GUI_VNC",
            "dependencies": [],
            "conflicts": [],
            "command": {
                "start": "bash /workspace/docker/gui_desktop.sh novnc start",
                "stop": "bash /workspace/docker/gui_desktop.sh novnc stop",
                "is_running": "bash /workspace/docker/gui_desktop.sh novnc status"
            },
            "default_on": false
        },
        {
            "id": "vnc",
            "name": "VNC Server",
            "description": "Native VNC for Screen Sharing / RealVNC (localhost:5901, password: lucy)",
            "type": "tool",
            "requires_env": "LUCY_GUI_VNC",
            "dev_only": true,
            "dependencies": [],
            "conflicts": [],
            "command": {
                "start": "bash /workspace/docker/gui_desktop.sh vnc start",
                "stop": "bash /workspace/docker/gui_desktop.sh vnc stop",
                "is_running": "bash /workspace/docker/gui_desktop.sh vnc status"
            },
            "default_on": false
        },
        {
            "id": "lucy_cli",
            "name": "Lucy CLI",
            "description": "Command Line Interface",
            "type": "interface",
            "dependencies": ["core"],
            "conflicts": [],
            "command": "ros2 run lucy_cli tui",
            "default_on": false
        },
        {
            "id": "console",
            "name": "Open Console",
            "description": "Opens a new interactive terminal window",
            "type": "tool",
            "dependencies": [],
            "conflicts": [],
            "command": "echo \"To navigate, press Ctrl+B then W\" && bash -i",
            "default_on": false
        },
        {
            "id": "rqt",
            "name": "rqt GUI",
            "description": "Main ROS 2 GUI tool",
            "type": "tool",
            "dependencies": ["core"],
            "conflicts": [],
            "command": "rqt",
            "runs_on_vnc": true,
            "default_on": false
        }
    ]
}
