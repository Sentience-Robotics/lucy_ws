# Lucy runtime image — ROS 2 Humble (Ubuntu 22.04 Jammy) with Gazebo Harmonic,
# ros2_control, RViz, rosbridge, GStreamer and Node 22 + Yarn for the control panel.
#
# Built and tagged as `lucy_ros2:humble` by docker/ensure_image.sh, which
# also computes the LUCY_FROM_PLATFORM / LUCY_BASE_IMAGE / LUCY_BOOTSTRAP_DESKTOP
# build args so the image is rebuilt whenever Dockerfile.humble or the target
# platform changes (LABEL lucy.dockerfile.sha256 = "<sha>|<platform>").
#
# Apple Silicon (Docker Desktop): osrf/ros:humble-desktop is amd64-only on Docker
# Hub. `./install.sh --arm` switches to the multi-arch ros:humble-ros-base-jammy
# base and installs `ros-humble-desktop` here (LUCY_BOOTSTRAP_DESKTOP=1).
#
# At runtime the host workspace is bind-mounted at /workspace by install.sh and
# launch_lucy.sh; this Dockerfile does not COPY any project source.

ARG LUCY_FROM_PLATFORM=linux/amd64
ARG LUCY_BASE_IMAGE=osrf/ros:humble-desktop
FROM --platform=${LUCY_FROM_PLATFORM} ${LUCY_BASE_IMAGE}

ARG LUCY_BOOTSTRAP_DESKTOP=0
ARG LUCY_INSTALL_VNC=0
ARG DOCKERFILE_SHA256=unknown
ARG LUCY_DOCKER_BUILD_PLATFORM=unknown
LABEL lucy.dockerfile.sha256="${DOCKERFILE_SHA256}|${LUCY_DOCKER_BUILD_PLATFORM}|vnc=${LUCY_INSTALL_VNC}"

# ARM path: the base is ros-base, so pull in the full desktop metapackage
# (RViz, demos, etc.) to match what osrf/ros:humble-desktop provides on amd64.
RUN if [ "${LUCY_BOOTSTRAP_DESKTOP}" = 1 ]; then \
      apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install \
      -o Acquire::http::Pipeline-Depth=0 \
      -o Acquire::http::No-Cache=true \
      -y --no-install-recommends \
      ros-humble-desktop \
    && rm -rf /var/lib/apt/lists/*; \
    fi

# Enable universe + multiverse — some bases only list `main`, which is missing
# python3-pytest-mock, GStreamer plugins, etc. required by rosdep below.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates software-properties-common \
 && add-apt-repository -y universe \
 && add-apt-repository -y multiverse \
 && apt-get update \
 && rm -rf /var/lib/apt/lists/*

# ports.ubuntu.com is fronted by Cloudflare and occasionally serves a stale
# Packages index that references .deb filenames already rotated out of the pool
# (404). Disable HTTP pipelining + caching and bump retries so apt copes with
# transient mirror inconsistencies instead of failing the whole layer.
RUN printf '%s\n' \
      'Acquire::http::Pipeline-Depth "0";' \
      'Acquire::http::No-Cache "true";' \
      'Acquire::Retries "5";' \
      > /etc/apt/apt.conf.d/99-lucy-mirror-resilience

# Gazebo Harmonic (the `gz sim` binary used by ros_gz_sim launches).
# Humble officially ships Fortress; Harmonic uses OSRF packages (ros-gzharmonic).
# https://gazebosim.org/docs/harmonic/ros_installation/
RUN apt-get update && apt-get install -y --no-install-recommends --fix-missing \
      curl lsb-release gnupg \
 && curl -sSL https://packages.osrfoundation.org/gazebo.gpg -o /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] https://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" \
      > /etc/apt/sources.list.d/gazebo-stable.list \
 && apt-get update && apt-get install -y --no-install-recommends --fix-missing gz-harmonic \
 && rm -rf /var/lib/apt/lists/*

# ROS sim/control stack + apt prerequisites for the rosdep run in install.sh
# (lucy_bringup / camera_ros / GStreamer / pytest).
# ros-humble-ros-gzharmonic* debs are amd64-only on packages.osrfoundation.org;
# arm64 builds ros_gz from source in the layer below (gazebosim/ros_gz#614).
RUN apt-get update && apt-get install -y --no-install-recommends \
      git wget \
      ros-humble-simulation-interfaces \
      ros-humble-ros2-control \
      ros-humble-ros2-control-cmake \
      ros-humble-ros2-controllers \
      ros-humble-xacro \
      ros-humble-rosbridge-server \
      ros-humble-realsense2-camera \
      ros-humble-compressed-image-transport \
      python3-colcon-common-extensions \
      python3-rosdep2 \
      python3-pytest-cov \
      python3-pytest-mock \
      gstreamer1.0-tools \
      gstreamer1.0-plugins-good \
      libgstreamer-plugins-good1.0-0 \
      tmux \
 && wget -q https://raw.githubusercontent.com/osrf/osrf-rosdep/master/gz/00-gazebo.list \
      -O /etc/ros/rosdep/sources.list.d/00-gazebo.list \
 && rosdep update \
 && rm -rf /var/lib/apt/lists/*

# amd64: OSRF hosts ros-humble-ros-gzharmonic debs (not built for arm64).
RUN if [ "$(dpkg --print-architecture)" = "amd64" ]; then \
      apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-ros-gzharmonic \
        ros-humble-ros-gzharmonic-bridge \
      && rm -rf /var/lib/apt/lists/*; \
    fi

# Humble+Harmonic: gz_ros2_control has no apt package on any arch; ros_gz has no
# arm64 debs — build from source (humble branch, GZ_VERSION=harmonic).
# https://control.ros.org/humble/doc/gz_ros2_control/doc/index.html
RUN bash -c 'set -e \
 && ARCH=$(dpkg --print-architecture) \
 && mkdir -p /opt/gz_ros2_control_ws/src \
 && if [ "$ARCH" = "arm64" ]; then \
      git clone --depth 1 --branch humble https://github.com/gazebosim/ros_gz.git \
        /opt/gz_ros2_control_ws/src/ros_gz; \
    fi \
 && git clone --depth 1 --branch humble https://github.com/ros-controls/gz_ros2_control.git \
      /opt/gz_ros2_control_ws/src/gz_ros2_control \
 && source /opt/ros/humble/setup.bash \
 && export GZ_VERSION=harmonic \
 && cd /opt/gz_ros2_control_ws \
 && if [ "$ARCH" = "arm64" ]; then \
      apt-get update && apt-get install -y --no-install-recommends \
        libgflags-dev \
        ros-humble-actuator-msgs \
        ros-humble-gps-msgs \
        ros-humble-vision-msgs \
      && rm -rf /var/lib/apt/lists/* \
      && rosdep install -r --from-paths \
           src/ros_gz/ros_gz_interfaces \
           src/ros_gz/ros_gz_bridge \
           src/ros_gz/ros_gz_sim \
           src/gz_ros2_control \
         --ignore-src --rosdistro humble -y \
      && colcon build --parallel-workers=1 \
         --packages-select ros_gz_interfaces ros_gz_bridge ros_gz_sim gz_ros2_control; \
    else \
      rosdep install -r --from-paths src --ignore-src --rosdistro humble -y \
        --skip-keys="ros_gz_bridge ros_gz_sim gz_ros2_control_demos" \
      && colcon build --packages-select gz_ros2_control; \
    fi \
 && rm -rf /opt/gz_ros2_control_ws/build /opt/gz_ros2_control_ws/log \
      /opt/gz_ros2_control_ws/src'

# Node 22 + Yarn — the lucy_control_panel Vite dev server runs inside this image.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && npm install -g yarn \
 && rm -rf /var/lib/apt/lists/*

# Virtual GUI desktop: Xvfb + a window manager + VNC + noVNC. Installed when
# LUCY_INSTALL_VNC=1 — set by ensure_image.sh on arm64, or on any arch when the
# host exports LUCY_FORCE_VNC=1. Where native X11/GLX is unavailable or unreliable
# for GL apps, RViz/Gazebo render into this in-container display with Mesa llvmpipe
# software GL and are viewed over VNC / noVNC. mesa-utils ships glxinfo for
# diagnostics. AMD64 (without the override) uses native X11 and ships none of this.
# See docker/gui_desktop.sh and launch_lucy.sh.
RUN if [ "${LUCY_INSTALL_VNC}" = 1 ]; then \
      apt-get update && apt-get install -y --no-install-recommends \
        xvfb \
        x11vnc \
        fluxbox \
        novnc \
        websockify \
        mesa-utils \
      && rm -rf /var/lib/apt/lists/*; \
    fi

# Setup bashrc with alias for the TUI launcher
RUN echo "alias launcher='python3 /workspace/launcher.py'" >> ~/.bashrc
RUN echo "alias exit=''" >> ~/.bashrc # Disable 'exit' to force launcher usage

WORKDIR /workspace
ENTRYPOINT ["/bin/bash"]
CMD ["-c", "source /opt/ros/humble/setup.bash && source /opt/gz_ros2_control_ws/install/setup.bash && exec /bin/bash"]
